# Copy to .env. No secrets are needed: every service runs locally.

# Local LLM - any OpenAI-compatible endpoint.
# Ollama in docker compose (default):
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# Ollama / llama.cpp / mlx_lm.server running on the host instead:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# A smaller model for a quick try on a laptop:
# LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=not-needed
LLM_TIMEOUT_S=600

# Embeddings (Infinity, OpenAI-compatible). Changing the model means
# re-indexing: stored vectors depend on it.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

QDRANT_COLLECTION=brand-brain
RETRIEVAL_K=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
COMPRESS_CONTEXT=false
ANSWER_LANGUAGE=English
